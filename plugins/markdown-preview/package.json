{
  "name": "kmerdan-markdown-preview",
  "version": "0.1.8",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --test test.cjs",
    "debug": "nnp-debug . --input demo.md --output .debug/preview.html",
    "dev": "nnp-debug . --input demo.md --output .debug/preview.html --watch",
    "debug:break": "node --enable-source-maps --inspect-brk=127.0.0.1:9229 ./node_modules/@notepadnext/plugin-sdk/debug.cjs . --input demo.md --output .debug/preview.html",
    "package": "nnp-package .",
    "bundle": "nnp-release ."
  },
  "devDependencies": {
    "@notepadnext/plugin-sdk": "https://github.com/KMerdan/notepadnext-plugin-sdk/releases/download/v0.3.2/notepadnext-plugin-sdk-0.3.2.tgz",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "markdown-it": "15.0.2"
  }
}
