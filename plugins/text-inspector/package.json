{
  "name": "kmerdan-text-inspector",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.cjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --test test.cjs",
    "debug": "nnp-debug . --input demo.md --output .debug/preview.html --api-version 0.3.0",
    "dev": "nnp-debug . --input demo.md --output .debug/preview.html --watch --api-version 0.3.0",
    "debug:break": "node --enable-source-maps --inspect-brk=127.0.0.1:9229 ./node_modules/@notepadnext/plugin-sdk/debug.cjs . --input demo.md --output .debug/preview.html --api-version 0.3.0",
    "package": "nnp-package .",
    "bundle": "nnp-release ."
  },
  "devDependencies": {
    "@notepadnext/plugin-sdk": "https://github.com/KMerdan/notepadnext-plugin-sdk/archive/69393865b9fafb2d724014174ffbbcf162e95b37.tar.gz",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
