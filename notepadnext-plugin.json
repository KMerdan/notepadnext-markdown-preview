{
  "manifestVersion": 1,
  "id": "kmerdan.official-plugins",
  "name": "Notepad Next ++ Official Plugins",
  "version": "0.1.3",
  "description": "First-party Markdown and HTML previews for Notepad Next ++. Register this catalog, then choose which plugins to install.",
  "repository": "https://github.com/KMerdan/notepadnext-markdown-preview",
  "list": [
    {
      "manifestVersion": 1,
      "id": "kmerdan.markdown-preview",
      "name": "Markdown Preview",
      "version": "0.1.6",
      "list": false,
      "description": "Preview the current Markdown buffer, including unsaved edits.",
      "engines": {
        "notepadnext": ">=0.15.0 <0.16.0",
        "api": "^0.1.0"
      },
      "runtime": {
        "kind": "node",
        "entry": "dist/index.js"
      },
      "capabilities": {
        "required": [
          "documents.read@1",
          "documents.events@1",
          "commands@1",
          "webviews@1",
          "webviews.restore@1"
        ],
        "optional": []
      },
      "activationEvents": [
        "onCommand:kmerdan.markdown-preview.open",
        "onCommand:kmerdan.markdown-preview.refresh"
      ],
      "contributes": {
        "commands": [
          {
            "id": "kmerdan.markdown-preview.open",
            "title": "Open Markdown Preview",
            "icon": "resources/markdown-preview.png"
          },
          {
            "id": "kmerdan.markdown-preview.refresh",
            "title": "Refresh Markdown Preview"
          }
        ],
        "menus": [
          {
            "location": "plugins",
            "command": "kmerdan.markdown-preview.open",
            "order": 100
          },
          {
            "location": "plugins",
            "command": "kmerdan.markdown-preview.refresh",
            "order": 110
          }
        ],
        "toolbar": [
          {
            "command": "kmerdan.markdown-preview.open",
            "order": 100
          }
        ]
      },
      "repository": "https://github.com/KMerdan/notepadnext-markdown-preview"
    },
    {
      "manifestVersion": 1,
      "id": "kmerdan.html-preview",
      "name": "HTML Preview",
      "description": "Run HTML and JavaScript through an activation-owned local Node.js service.",
      "version": "0.1.2",
      "list": false,
      "engines": {
        "notepadnext": ">=0.15.0 <0.16.0",
        "api": "^0.1.0"
      },
      "runtime": {
        "kind": "node",
        "entry": "dist/index.js"
      },
      "capabilities": {
        "required": [
          "commands@1",
          "documents.read@1",
          "documents.events@1",
          "webviews@1",
          "webviews.service@1",
          "webviews.restore@1"
        ],
        "optional": []
      },
      "activationEvents": [
        "onCommand:kmerdan.html-preview.open"
      ],
      "contributes": {
        "commands": [
          {
            "id": "kmerdan.html-preview.open",
            "title": "Open HTML Preview"
          }
        ],
        "menus": [
          {
            "location": "plugins",
            "command": "kmerdan.html-preview.open",
            "order": 120
          }
        ]
      },
      "repository": "https://github.com/KMerdan/notepadnext-markdown-preview"
    },
    {
      "manifestVersion": 1,
      "id": "kmerdan.text-inspector",
      "name": "Text Inspector",
      "version": "0.1.0",
      "list": false,
      "description": "Inspect and navigate selected editor text.",
      "engines": {
        "notepadnext": ">=0.15.0 <0.16.0",
        "api": "^0.3.0"
      },
      "runtime": {
        "kind": "node",
        "entry": "dist/index.js"
      },
      "capabilities": {
        "required": [
          "commands@1",
          "messages@1",
          "documents.read@1",
          "documents.native.events@1",
          "editors.selection.read@1",
          "editors.view.write@1",
          "webviews@1",
          "webviews.restore@1",
          "editors.selection.events@1"
        ],
        "optional": []
      },
      "activationEvents": [
        "onCommand:kmerdan.text-inspector.show",
        "onCommand:kmerdan.text-inspector.reveal"
      ],
      "contributes": {
        "commands": [
          {
            "id": "kmerdan.text-inspector.show",
            "title": "Open Text Inspector",
            "icon": "dist/media/icon.png"
          },
          {
            "id": "kmerdan.text-inspector.reveal",
            "title": "Reveal inspected selection",
            "icon": "dist/media/icon.png"
          }
        ],
        "menus": [
          {
            "location": "plugins",
            "command": "kmerdan.text-inspector.show",
            "order": 110
          },
          {
            "location": "plugins",
            "command": "kmerdan.text-inspector.reveal",
            "order": 111
          }
        ]
      },
      "repository": "https://github.com/KMerdan/notepadnext-markdown-preview"
    },
    {
      "manifestVersion": 1,
      "id": "kmerdan.todo-navigator",
      "name": "TODO Navigator",
      "version": "0.1.0",
      "list": false,
      "description": "Find TODO markers, highlight their native ranges and navigate results.",
      "engines": {
        "notepadnext": ">=0.15.0 <0.16.0",
        "api": "^0.3.0"
      },
      "runtime": {
        "kind": "node",
        "entry": "dist/index.js"
      },
      "capabilities": {
        "required": [
          "commands@1",
          "messages@1",
          "documents.read@1",
          "documents.native.events@1",
          "editors.selection.read@1",
          "editors.view.write@1",
          "webviews@1",
          "webviews.restore@1",
          "search.read@1",
          "decorations.write@1",
          "webviews.html@1"
        ],
        "optional": []
      },
      "activationEvents": [
        "onCommand:kmerdan.todo-navigator.show"
      ],
      "contributes": {
        "commands": [
          {
            "id": "kmerdan.todo-navigator.show",
            "title": "Open TODO Navigator",
            "icon": "dist/media/icon.png"
          }
        ],
        "menus": [
          {
            "location": "plugins",
            "command": "kmerdan.todo-navigator.show",
            "order": 110
          }
        ]
      },
      "repository": "https://github.com/KMerdan/notepadnext-markdown-preview"
    }
  ]
}
