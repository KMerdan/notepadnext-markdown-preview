{
  "manifestVersion": 1,
  "id": "kmerdan.todo-navigator",
  "name": "SDK Example: TODO Navigator",
  "version": "0.1.1",
  "list": false,
  "description": "Developer example for native SDK APIs. Not a production editor tool.",
  "engines": {
    "notepadnext": ">=0.15.2 <0.16.0",
    "api": "^0.3.0"
  },
  "runtime": {
    "kind": "node",
    "entry": "dist/index.js"
  },
  "capabilities": {
    "required": [
      "commands@1",
      "messages@1",
      "documents.read@1",
      "documents.native.events@1",
      "editors.selection.read@1",
      "editors.view.write@1",
      "webviews@1",
      "webviews.restore@1",
      "search.read@1",
      "decorations.write@1",
      "webviews.html@1"
    ],
    "optional": []
  },
  "activationEvents": [
    "onCommand:kmerdan.todo-navigator.show"
  ],
  "contributes": {
    "commands": [
      {
        "id": "kmerdan.todo-navigator.show",
        "title": "Open TODO Navigator",
        "icon": "dist/media/icon.png"
      }
    ],
    "menus": [
      {
        "location": "plugins",
        "command": "kmerdan.todo-navigator.show",
        "order": 110
      }
    ]
  },
  "repository": "https://github.com/KMerdan/notepadnext-plugin-marketplace",
  "category": "editor-tool"
}
